# 页面标题
VITE_APP_TITLE = 数据后台（开发）

# 开发环境配置
VITE_APP_ENV = 'development'

# 基础URL
VITE_APP_BASE_URL = '/data-admin/'

# 若依管理系统/开发环境
VITE_APP_BASE_API = '/dev-api'

# 后端接口地址（请在 .env.local 中配置本地开发的后端地址）
